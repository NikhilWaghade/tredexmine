##############################################################################
# TreadExMine Server — Environment Variable Template
# Copy this file to .env and fill in real values.  NEVER commit .env itself.
##############################################################################

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # Must be: development | test | production

# ── MongoDB ─────────────────────────────────────────────────────────────────
# PRODUCTION: use a replica-set URI (transactions require replica set).
# TEST: use a local standalone or mongodb-memory-server URI.
MONGODB_URI=mongodb://localhost:27017/treadexmine

# ── JWT Secrets ──────────────────────────────────────────────────────────────
# Production requirement: distinct secrets, minimum 32 characters each.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_access_secret_minimum_32_characters_long_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_here

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
STAGING_CLIENT_URL=   # Optional: add staging frontend origin here

# ── Razorpay Payment Gateway (use rzp_test_* keys in non-production) ─────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
# Production requirement: minimum 32 characters
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder_minimum_32_chars

# ── Email / SMTP (optional — leave blank to disable email features) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Cloudinary (optional — leave blank to disable image upload) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
